[
  {"id": "q-plus", "group": "쿼리", "title": "공백을 +로 보낸 검색(FE가 보내는 형태)", "method": "GET", "path": "/api/post?size=20&search=Spring+Boot"},
  {"id": "q-pct20", "group": "쿼리", "title": "공백을 %20으로 보낸 검색", "method": "GET", "path": "/api/post?size=20&search=Spring%20Boot"},
  {"id": "q-pct2b", "group": "쿼리", "title": "글자 그대로의 +(%2B)", "method": "GET", "path": "/api/post?size=20&search=C%2B%2B"},
  {"id": "q-repeat", "group": "쿼리", "title": "같은 키 반복", "method": "GET", "path": "/api/post?size=20&search=Spring&search=Boot"},
  {"id": "q-novalue", "group": "쿼리", "title": "값 없는 키", "method": "GET", "path": "/api/post?size=20&search"},
  {"id": "q-empty", "group": "쿼리", "title": "빈 값", "method": "GET", "path": "/api/post?size=20&search="},
  {"id": "q-eq", "group": "쿼리", "title": "값 안의 =를 그대로", "method": "GET", "path": "/api/post?size=20&search=a=b", "reach": "일반 사용 경로 아님: FE의 URLSearchParams는 =를 %3D로 보낸다. 손으로 친 URL은 도달한다(2026-11-07 운영 측정)"},
  {"id": "q-eq-enc", "group": "쿼리", "title": "값 안의 =(%3D, FE가 보내는 형태)", "method": "GET", "path": "/api/post?size=20&search=a%3Db"},
  {"id": "q-amp-enc", "group": "쿼리", "title": "값 안의 &(%26, FE가 보내는 형태)", "method": "GET", "path": "/api/post?size=20&search=a%26b"},
  {"id": "q-comma-enc", "group": "쿼리", "title": "값 안의 ,(%2C, FE가 보내는 형태)", "method": "GET", "path": "/api/post?size=20&search=a%2Cb"},
  {"id": "q-korean", "group": "쿼리", "title": "인코딩된 한글", "method": "GET", "path": "/api/post?size=20&search=%EB%A6%AC%EC%95%A1%ED%8A%B8"},
  {"id": "q-percent", "group": "쿼리", "title": "글자 그대로의 %(%25)", "method": "GET", "path": "/api/post?size=20&search=100%25"},
  {"id": "q-broken", "group": "쿼리", "title": "깨진 %ZZ", "method": "GET", "path": "/api/post?size=20&search=%ZZ", "reach": "CloudFront가 400으로 막아 도달 안 함(2026-11-07 운영 측정)"},
  {"id": "q-bracket", "group": "쿼리", "title": "인코딩 안 한 [", "method": "GET", "path": "/api/post?size=20&search=[%ED%83%9C%EA%B7%B8]", "reach": "도달한다(2026-11-07 운영 측정, 200). 문서의 rawQueryString 지원 문자 밖이지만 통과한다"},
  {"id": "q-pipe", "group": "쿼리", "title": "인코딩 안 한 |", "method": "GET", "path": "/api/post?size=20&search=a|b", "reach": "CloudFront가 400으로 막아 도달 안 함(2026-11-07 운영 측정)"},
  {"id": "q-bad-int", "group": "쿼리", "title": "숫자 자리에 글자", "method": "GET", "path": "/api/post?size=abc", "expect": {"bodyHas": "code"}, "requirement": "FE가 오류 본문의 code로 안내를 고른다"},

  {"id": "p-detail", "group": "경로", "title": "정상 상세", "method": "GET", "path": "/api/post/00000000-0000-4000-8000-000000000101"},
  {"id": "p-bad-uuid", "group": "경로", "title": "UUID 자리에 글자", "method": "GET", "path": "/api/post/not-a-uuid", "expect": {"bodyHas": "code"}, "requirement": "FE가 오류 본문의 code로 안내를 고른다"},
  {"id": "p-404-anon", "group": "경로", "title": "없는 경로(비로그인)", "method": "GET", "path": "/api/no-such-path", "expect": {"bodyHas": "code"}, "requirement": "오류 본문에 code가 있어야 한다"},
  {"id": "p-404-auth", "group": "경로", "title": "없는 경로의 404 본문(로그인)", "method": "GET", "path": "/api/no-such-path", "session": true, "headers": {"x-access-token": "{{accessToken}}"}, "expect": {"bodyHas": "code"}, "requirement": "오류 본문에 code가 있어야 한다"},
  {"id": "p-slash", "group": "경로", "title": "끝 슬래시", "method": "GET", "path": "/api/post/"},
  {"id": "p-enc-slash", "group": "경로", "title": "%2F", "method": "GET", "path": "/api/post%2Fabc", "reach": "실제 Function URL이 rawPath를 어떻게 넘기는지는 Phase 2"},
  {"id": "p-jsessionid", "group": "경로", "title": ";jsessionid=", "method": "GET", "path": "/api/post;jsessionid=abc", "reach": "문서가 rawPath 문자를 제한하지 않는다. 실제 처리는 Phase 2"},
  {"id": "p-dot", "group": "경로", "title": "..로 경로 우회 시도", "method": "GET", "path": "/api/post/%2e%2e/auth/account", "reach": "실제 Function URL이 rawPath를 어떻게 넘기는지는 Phase 2"},
  {"id": "p-pipe", "group": "경로", "title": "경로의 인코딩 안 한 |", "method": "GET", "path": "/api/post/a|b", "reach": "CloudFront가 400으로 막아 도달 안 함(2026-11-07 운영 측정)"},
  {"id": "p-broken", "group": "경로", "title": "경로의 깨진 %ZZ", "method": "GET", "path": "/api/post/%ZZ", "reach": "CloudFront가 400으로 막아 도달 안 함(2026-11-07 운영 측정)"},
  {"id": "p-api-only", "group": "경로", "title": "/api 단독", "method": "GET", "path": "/api", "reach": "도달 안 함: CloudFront 경로 패턴 /api/*는 /api를 잡지 않는다"},
  {"id": "p-outside", "group": "경로", "title": "/api 밖 경로", "method": "GET", "path": "/no-api/post", "reach": "도달 안 함: CloudFront는 /api/*만 Lambda로 보낸다(docs/DEPLOY.md)"},
  {"id": "p-double-api", "group": "경로", "title": "/api/api/post", "method": "GET", "path": "/api/api/post"},

  {"id": "m-405", "group": "메서드·본문", "title": "405", "method": "PUT", "path": "/api/auth/login", "headers": {"content-type": "application/json"}, "body": "{}", "expect": {"bodyHas": "code"}, "requirement": "오류 본문에 code가 있어야 한다"},
  {"id": "m-preflight", "group": "메서드·본문", "title": "CORS 사전 요청", "method": "OPTIONS", "path": "/api/post", "headers": {"origin": "https://linksphere.click", "access-control-request-method": "POST", "access-control-request-headers": "content-type,x-access-token"}, "expect": {"header": {"access-control-allow-origin": "https://linksphere.click"}}, "requirement": "FE 오리진의 CORS 사전 요청이 통과해야 한다"},
  {"id": "m-preflight-bad", "group": "메서드·본문", "title": "허용 안 된 Origin의 사전 요청", "method": "OPTIONS", "path": "/api/post", "headers": {"origin": "https://evil.example", "access-control-request-method": "POST"}},
  {"id": "m-head", "group": "메서드·본문", "title": "HEAD", "method": "HEAD", "path": "/api/post?size=1"},
  {"id": "m-bad-json", "group": "메서드·본문", "title": "깨진 JSON", "method": "POST", "path": "/api/auth/login", "headers": {"content-type": "application/json"}, "body": "{bad", "expect": {"bodyHas": "code"}, "requirement": "오류 본문에 code가 있어야 한다"},
  {"id": "m-415", "group": "메서드·본문", "title": "415", "method": "POST", "path": "/api/auth/login", "headers": {"content-type": "text/plain"}, "body": "hello", "expect": {"bodyHas": "code"}, "requirement": "오류 본문에 code가 있어야 한다"},
  {"id": "m-empty", "group": "메서드·본문", "title": "빈 본문", "method": "POST", "path": "/api/auth/login", "headers": {"content-type": "application/json"}, "expect": {"bodyHas": "code"}, "requirement": "오류 본문에 code가 있어야 한다"},
  {"id": "m-korean-json", "group": "메서드·본문", "title": "한글 JSON 본문", "method": "PATCH", "path": "/api/auth/account", "session": true, "headers": {"x-access-token": "{{accessToken}}", "content-type": "application/json"}, "body": "{\"nickname\":\"실험닉네임\"}", "expect": {"bodyHas": "실험닉네임"}, "requirement": "한글 본문이 깨지지 않아야 한다"},
  {"id": "m-base64", "group": "메서드·본문", "title": "base64 본문", "method": "PATCH", "path": "/api/auth/account", "session": true, "headers": {"x-access-token": "{{accessToken}}", "content-type": "application/json"}, "body": "{\"nickname\":\"실험닉네임둘\"}", "bodyBase64": true, "expect": {"bodyHas": "실험닉네임둘"}, "requirement": "Function URL이 base64로 준 본문을 읽어야 한다"},
  {"id": "m-form", "group": "메서드·본문", "title": "폼 본문(base64)", "method": "POST", "path": "/api/auth/login", "headers": {"content-type": "application/x-www-form-urlencoded"}, "body": "email=a%40example.invalid&password=x", "bodyBase64": true},

  {"id": "c-array", "group": "쿠키·인증", "title": "cookies 배열 여러 개", "method": "POST", "path": "/api/auth/refresh", "session": true, "cookies": ["first=1", "__Host-refreshToken={{refreshToken}}", "third=3"], "expect": {"status": 200}, "requirement": "Function URL은 쿠키를 cookies 배열로 준다. 그중 갱신 쿠키를 찾아야 한다"},
  {"id": "c-broken", "group": "쿠키·인증", "title": "깨진 쿠키", "method": "POST", "path": "/api/auth/refresh", "cookies": ["=novalue", "noequals", "a=b=c"], "expect": {"status": 401}, "requirement": "깨진 쿠키가 있어도 함수 실패 없이 401이어야 한다"},
  {"id": "c-quoted", "group": "쿠키·인증", "title": "따옴표 값", "method": "POST", "path": "/api/auth/refresh", "session": true, "cookies": ["__Host-refreshToken=\"{{refreshToken}}\""], "reach": "일반 사용 경로 아님: 서버가 따옴표 쿠키를 만들지 않아 브라우저가 이렇게 보내지 않는다"},
  {"id": "a-bad-token", "group": "쿠키·인증", "title": "잘못된 토큰 401", "method": "GET", "path": "/api/auth/account", "headers": {"x-access-token": "invalid-token"}, "expect": {"status": 401, "bodyHas": "code"}, "requirement": "토큰 만료 안내는 401과 code로 동작한다"},
  {"id": "a-bad-token-public", "group": "쿠키·인증", "title": "공개 조회에 잘못된 토큰", "method": "GET", "path": "/api/post?size=1", "headers": {"x-access-token": "invalid-token"}, "expect": {"status": 401, "bodyHas": "code"}, "requirement": "토큰 만료 안내는 401과 code로 동작한다"},
  {"id": "a-account", "group": "쿠키·인증", "title": "로그인 상태 조회", "method": "GET", "path": "/api/auth/account", "session": true, "headers": {"x-access-token": "{{accessToken}}"}, "expect": {"status": 200}, "requirement": "로그인 상태 조회가 동작해야 한다"},
  {"id": "a-login", "group": "쿠키·인증", "title": "로그인의 Set-Cookie", "method": "POST", "path": "/api/auth/login", "headers": {"content-type": "application/json"}, "body": "{\"email\":\"experiment-user@example.invalid\",\"password\":\"experiment-password\"}", "expect": {"status": 200, "cookie": "refreshToken="}, "requirement": "갱신 쿠키는 응답의 cookies로 나가야 한다(AWS 문서)"},
  {"id": "a-refresh", "group": "쿠키·인증", "title": "갱신의 Set-Cookie", "method": "POST", "path": "/api/auth/refresh", "session": true, "cookies": ["__Host-refreshToken={{refreshToken}}"], "expect": {"status": 200, "cookie": "refreshToken="}, "requirement": "갱신 쿠키는 응답의 cookies로 나가야 한다(AWS 문서)"},
  {"id": "a-logout", "group": "쿠키·인증", "title": "로그아웃의 Set-Cookie", "method": "POST", "path": "/api/auth/logout", "session": true, "cookies": ["__Host-refreshToken={{refreshToken}}"], "expect": {"status": 200, "cookie": "Max-Age=0"}, "requirement": "로그아웃은 쿠키를 지워야 한다"},
  {"id": "a-email-limit", "group": "쿠키·인증", "title": "이메일 로그인 실패 한도", "method": "POST", "path": "/api/auth/login", "headers": {"content-type": "application/json", "cloudfront-viewer-address": "203.0.113.20:1000"}, "body": "{\"email\":\"limit-target@example.invalid\",\"password\":\"wrong\"}", "repeatBefore": 5, "expect": {"status": 429}, "requirement": "이메일 15분 5회 로그인 한도"},
  {"id": "a-ip-limit", "group": "쿠키·인증", "title": "CloudFront-Viewer-Address로 도는 IP 한도", "method": "POST", "path": "/api/auth/login", "headers": {"content-type": "application/json", "cloudfront-viewer-address": "203.0.113.30:1000"}, "body": "{\"email\":\"ip-{{i}}@example.invalid\",\"password\":\"wrong\"}", "repeatBefore": 20, "expect": {"status": 429}, "requirement": "IP 한도는 CloudFront-Viewer-Address 기준이다"},
  {"id": "a-ip-other", "group": "쿠키·인증", "title": "다른 IP는 한도에 안 걸림", "method": "POST", "path": "/api/auth/login", "headers": {"content-type": "application/json", "cloudfront-viewer-address": "203.0.113.31:1000"}, "body": "{\"email\":\"ip-other@example.invalid\",\"password\":\"wrong\"}", "expect": {"status": 401}, "requirement": "다른 IP는 한도에 걸리지 않아야 한다"},

  {"id": "r-cors", "group": "응답", "title": "Vary 여러 값(CORS 응답)", "method": "GET", "path": "/api/post?size=1", "headers": {"origin": "https://linksphere.click"}, "expect": {"header": {"vary": "Access-Control-Request-Method", "access-control-allow-origin": "https://linksphere.click"}}, "requirement": "값이 여럿인 Vary가 모두 나가야 한다(#121)"},
  {"id": "r-hsts", "group": "응답", "title": "HSTS", "method": "GET", "path": "/api/post?size=1", "expect": {"header": {"strict-transport-security": "max-age=31536000"}}, "requirement": "HTTPS 응답에 HSTS가 붙어야 한다(#40)"},
  {"id": "r-type", "group": "응답", "title": "Content-Type charset·한글 본문", "method": "GET", "path": "/api/common/category-option", "expect": {"bodyHas": "개발"}, "requirement": "한글 응답이 UTF-8로 나가야 한다"},
  {"id": "r-health", "group": "응답", "title": "헬스 체크", "method": "GET", "path": "/api/actuator/health", "expect": {"status": 200}, "requirement": "헬스 체크가 200과 UP이어야 한다"},
  {"id": "r-view", "group": "응답", "title": "빈 data 응답(조회 기록)", "method": "POST", "path": "/api/post/00000000-0000-4000-8000-000000000102/view"},
  {"id": "r-api-docs", "group": "응답", "title": "OpenAPI 문서의 서버 주소", "method": "GET", "path": "/api/v3/api-docs"},
  {"id": "r-validation", "group": "응답", "title": "검증 실패 본문", "method": "POST", "path": "/api/auth/signup", "headers": {"content-type": "application/json"}, "body": "{\"email\":\"not-an-email\",\"password\":\"x\",\"nickname\":\"x\"}", "expect": {"status": 400, "bodyHas": "code"}, "requirement": "오류 본문에 code가 있어야 한다"},

  {"id": "h-7500", "group": "큰 요청", "title": "헤더 합계 약 7.5KB", "method": "GET", "path": "/api/post?size=1", "headerTotalBytes": 7500, "reach": "도달 미확인: 실제 CloudFront·Function URL의 처리는 Phase 2. 지금 FE가 이만큼 보내지는 않는다"},
  {"id": "h-9000", "group": "큰 요청", "title": "헤더 합계 약 9KB", "method": "GET", "path": "/api/post?size=1", "headerTotalBytes": 9000, "reach": "도달 미확인: 실제 CloudFront·Function URL의 처리는 Phase 2. 지금 FE가 이만큼 보내지는 않는다"},
  {"id": "b-8000", "group": "큰 요청", "title": "WAF 한도 안의 큰 본문(8,000바이트)", "method": "POST", "path": "/api/auth/login", "headers": {"content-type": "application/json", "cloudfront-viewer-address": "203.0.113.40:1000"}, "bodyTotalBytes": 8000, "body": "{\"email\":\"big@example.invalid\",\"password\":\"{{pad}}\"}", "expect": {"status": 401}, "requirement": "WAF 8KB 한도 안의 본문이 앱까지 가야 한다"},

  {"id": "l-ping", "group": "Lambda 전용", "title": "워밍 핑 최소 이벤트", "lambdaOnly": true, "event": {"rawPath": "/api/actuator/health", "requestContext": {"http": {"method": "GET"}}}, "expect": {"status": 200, "bodyHas": "UP"}, "reach": "내부 호출(EventBridge·자기 호출·배포 관문)", "requirement": "EventBridge 워밍 핑이 200이어야 한다"},
  {"id": "l-gate", "group": "Lambda 전용", "title": "배포 관문 최소 이벤트", "lambdaOnly": true, "event": {"rawPath": "/api/post", "rawQueryString": "page=0&size=5", "requestContext": {"http": {"method": "GET"}}}, "expect": {"status": 200, "bodyHas": "nextCursor"}, "reach": "내부 호출(EventBridge·자기 호출·배포 관문)", "requirement": "배포 관문이 200과 nextCursor를 본다(deploy.yml)"},
  {"id": "l-ext-events", "group": "Lambda 전용", "title": "외부 요청이 내부 작업 경로를 때림", "lambdaOnly": true, "method": "POST", "path": "/api/internal/lambda-events", "headers": {"content-type": "application/json"}, "body": "{\"linksphereJob\":\"account-purge\"}", "dbCheck": {"sql": "select count(*) from auth_rate_limits where bucket_key='experiment-expired'", "expect": "1"}},
  {"id": "l-ext-forged", "group": "Lambda 전용", "title": "외부 요청이 패스스루 헤더를 위조", "lambdaOnly": true, "method": "POST", "path": "/api/internal/lambda-events", "headers": {"content-type": "application/json", "x-amzn-request-context": "null"}, "body": "{\"linksphereJob\":\"account-purge\"}", "dbCheck": {"sql": "select count(*) from auth_rate_limits where bucket_key='experiment-expired'", "expect": "1"}},
  {"id": "l-ext-hook", "group": "Lambda 전용", "title": "외부 요청이 스냅샷 훅을 때림", "lambdaOnly": true, "method": "POST", "path": "/api/internal/snapstart/before"},
  {"id": "l-after-hook", "group": "Lambda 전용", "title": "외부 훅 시도 뒤 DB 요청", "lambdaOnly": true, "method": "GET", "path": "/api/post?size=1", "expect": {"status": 200}, "requirement": "외부 훅 시도 뒤에도 DB 요청이 정상이어야 한다"},
  {"id": "l-job-purge", "group": "Lambda 전용", "title": "내부 작업 account-purge", "lambdaOnly": true, "event": {"linksphereJob": "account-purge"}, "expect": {"status": 200}, "dbCheck": {"sql": "select count(*) from auth_rate_limits where bucket_key='experiment-expired'", "expect": "0"}, "reach": "내부 호출(EventBridge·자기 호출·배포 관문)", "requirement": "끝난 레이트리밋 창의 행을 실제로 지워야 한다"},
